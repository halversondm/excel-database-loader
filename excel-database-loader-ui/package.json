{
  "name": "excel-database-loader-ui",
  "version": "1.0.0",
  "description": "Display homweowners from a an Excel database in a React application with Tailwind CSS.",
  "private": true,
  "author": "Dan Halverson <daniel.m.halverson@gmail.com",
  "license": "MIT",
  "keywords": [
    "react",
    "javascript",
    "frontend",
    "web-app",
    "tailwind",
    "responsive"
  ],
  "homepage": ".",
  "main": "src/index.js",
  "scripts": {
    "start": "vite",
    "prebuild": "npm run test -- run && npm run lint",
    "build": "vite build",
    "test": "vitest",
    "lint": "eslint",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "preview": "npm run build && serve -s build",
    "analyze": "npm run build && npx bundle-analyzer build/static/js/*.js"
  },
  "dependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "lucide-react": "^1.47.0",
    "prop-types": "^15.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "web-vitals": "^6.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "prettier": {
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 80,
    "tabWidth": 4,
    "useTabs": false
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/react-app-skeleton.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/react-app-skeleton/issues"
  },
  "proxy": "http://localhost:8082"
}
